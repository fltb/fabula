{
  "name": "@novalistically/workbench",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/host/contracts/index.js",
  "types": "./dist/contracts/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/host/contracts/index.js",
      "types": "./dist/contracts/index.d.ts"
    },
    "./contracts": {
      "import": "./dist/host/contracts/index.js",
      "types": "./dist/contracts/index.d.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:host": "node --watch build.host.mjs",
    "build:host": "npm run typecheck:host && node build.host.mjs",
    "start:host": "node scripts/start.mjs workbench",
    "start:listener": "node scripts/start.mjs listener",
    "start:workbench": "node scripts/start.mjs workbench",
    "dev:client": "vite --config vite.config.ts",
    "build:client": "vite build --config vite.config.ts",
    "test:host": "vitest run --config vitest.host.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:e2e": "playwright test",
    "smoke:workbench-agent:live": "node scripts/smoke-agent-live.mjs",
    "typecheck:host": "tsc -p tsconfig.json",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "build": "npm run build:host && npm run build:client"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@novalistically/core": "^0.1.0",
    "@novalistically/node-host": "^0.1.0",
    "@novalistically/workbench-protocol": "^0.1.0",
    "hono": "^4.7.11",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.4.2",
    "solid-js": "^1.9.7",
    "solid-markdown": "^2.1.1",
    "@solidjs/router": "^0.15.3",
    "@kobalte/core": "^0.13.8",
    "@tanstack/solid-query": "^5.80.7",
    "yjs": "^13.6.27",
    "y-websocket": "^2.0.4",
    "@y/websocket-server": "^0.1.2",
    "ws": "^8.18.1",
    "y-codemirror.next": "^0.3.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@codemirror/language": "^6.11.0",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/lang-yaml": "^6.1.1",
    "@logicflow/core": "^1.2.28",
    "@logicflow/extension": "^1.2.28",
    "kysely": "^0.28.2"
  },
  "devDependencies": {
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.6",
    "tailwindcss": "^4.1.7",
    "@tailwindcss/vite": "^4.1.7",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "msw": "^2.10.2",
    "@playwright/test": "^1.52.0",
    "@axe-core/playwright": "^4.10.2",
    "@types/ws": "^8.5.14"
  }
}
