{
  "name": "@novalistically/core",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./source": {
      "import": "./dist/source.js",
      "types": "./dist/source.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./extensions": {
      "import": "./dist/extensions.js",
      "types": "./dist/extensions.d.ts"
    },
    "./editorial": {
      "import": "./dist/editorial.js",
      "types": "./dist/editorial.d.ts"
    },
    "./tooling": {
      "import": "./dist/tooling.js",
      "types": "./dist/tooling.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node build.mjs",
    "build:js": "node build.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tinybench": "^6.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
