node_modules/
dist/
*.tsbuildinfo
.nova/snapshots/
.nova/index.sqlite
output/

# Node Host publication-writer SOURCE lives in src/output/ — do not ignore it
!packages/node-host/src/output/

# Bench results — regenerated every run, not source-controlled
packages/bench/**/results/
packages/*/bench/results/

# External benchmark datasets — downloaded artifacts, not source-controlled
bench-data/

# Deepwork state files — local only, not committed
.slim/deepwork/
docs/superpowers/

.omp/
# OMP session dumps (untracked; produced by sandbox)
omp-session-*.html
# Environment files
.env
.env.*
!.env.example

# Workbench runtime state (root and any workspace/package .nova directories)
.nova/workbench.sqlite*
**/.nova/workbench.sqlite*
.nova/workbench/

# Workbench probe/esbuild scratch artifacts (smoke-agent-live, probe-run, cap bundles)
packages/workbench/probe-run.mjs
packages/workbench/*-bundle-*/
packages/workbench/.nova/
