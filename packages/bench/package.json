{
  "name": "@novalistically/bench",
  "version": "0.1.0",
  "description": "Benchmark and performance suite for Novalistically — runs the full pipeline on real fixtures and measures throughput at N=10/100/1000.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "bench": "vitest run",
    "build": "tsc --emitDeclarationOnly && node build.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@novalistically/core": "*",
    "apache-arrow": "^18.0.0",
    "tinybench": "^6.0.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
