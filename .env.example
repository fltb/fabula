# Optional explicit env-file path used by Workbench Node launchers; shell variables still win.
# WORKBENCH_ENV_FILE=/etc/fabula/workbench.env
# Fabula provider (production Workbench requires the key; never commit real values)
NOVALISTICALLY_AI_API_KEY=
NOVALISTICALLY_AI_BASE_URL=https://opencode.ai/zen/v1
NOVALISTICALLY_AI_MODEL=deepseek-v4-flash-free

# Workbench launch mode: workbench = composed UI/API; listener = health/status smoke only
WORKBENCH_MODE=workbench
# Absolute project directory containing nova.yaml
WORKBENCH_PROJECT_ROOT=
# Absolute SQLite path owned by the Workbench Host
WORKBENCH_DATABASE_PATH=
# Production points to packages/workbench/dist/client; development leaves this unset (Vite serves assets)
# WORKBENCH_ASSETS_ROOT=
WORKBENCH_PROJECT_ID=
WORKBENCH_DISPLAY_NAME=
WORKBENCH_PORT=8787
WORKBENCH_HOST=loopback
WORKBENCH_LAN=false
WORKBENCH_ALLOWED_HOSTS=127.0.0.1
# Development Vite origin; set an explicit trusted origin when using another browser origin
WORKBENCH_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional reverse-proxy mode; TLS terminates at the proxy, never in Workbench
# WORKBENCH_UNIX_SOCKET=/run/fabula/workbench.sock
# WORKBENCH_TRUST_FORWARDED_HEADERS=true

# Development-only explicit switches. Keep both false/unset in production.
WORKBENCH_PROVIDER=ai-sdk
WORKBENCH_ALLOW_MOCK_PROVIDER=false
WORKBENCH_ALLOW_BOOTSTRAP=false
