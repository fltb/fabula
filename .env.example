# Workbench launch template. It contains no provider credential: the Host stores
# provider keys through first-run setup or owner administration. Do not add a key
# to this file, .env, workbench.yaml, browser storage, or MCP configuration.
#
# Launcher precedence: WORKBENCH_ENV_FILE, then cwd/.env, then repository .env.
# Shell variables win. Empty values are treated as unset.

# ── Host-owned state and listener ─────────────────────────────────────────────
# WORKBENCH_HOME=/var/lib/fabula/workbench
# WORKBENCH_DATABASE_PATH=/var/lib/fabula/workbench/workbench.sqlite
# WORKBENCH_ASSETS_ROOT=/srv/fabula/app/packages/workbench/dist/client
WORKBENCH_PORT=8787
WORKBENCH_HOST=loopback
WORKBENCH_LAN=false
WORKBENCH_ALLOWED_HOSTS=127.0.0.1
# Set this to the actual browser origin for development or LAN use.
WORKBENCH_ALLOWED_ORIGINS=http://127.0.0.1:5173
# WORKBENCH_UNIX_SOCKET=/run/fabula/workbench.sock
# WORKBENCH_TRUST_FORWARDED_HEADERS=true

# ── Development browser server ───────────────────────────────────────────────
# Only used by `npm run -w @novalistically/workbench dev`.
# It is deliberately distinct from WORKBENCH_PORT, which remains the Host and
# Vite proxy target.
WORKBENCH_VITE_PORT=5173

# ── Optional legacy development prefill ──────────────────────────────────────
# This starts one configured project before workbench.yaml is created. The
# normal multi-project source of truth is $WORKBENCH_HOME/config/workbench.yaml.
# The path must be an independent Workbench-managed repository root, not a
# fixture nested in another Git repository.
# WORKBENCH_PROJECT_ROOT=/absolute/path/to/project
# WORKBENCH_PROJECT_ID=my-project
# WORKBENCH_DISPLAY_NAME=My project

# ── Explicit development-only opt-ins ─────────────────────────────────────────
# Production keeps these unset/false and configures a real provider through the
# Host setup/admin UI. Mock rendering and loopback bootstrap must never be a
# production default.
# WORKBENCH_PROVIDER=mock
# WORKBENCH_ALLOW_MOCK_PROVIDER=true
# WORKBENCH_ALLOW_BOOTSTRAP=true
