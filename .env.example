# Fabula environment template — production-safe defaults. Development overrides are documented
# in the README "Start and use Workbench" section and in dev.mjs. Never commit real secrets.
# Launchers discover this file in order: WORKBENCH_ENV_FILE → working-directory .env → repository-root .env.
# Shell variables always win over file values.

# ── AI provider ───────────────────────────────────────────────────────────────
# Production (WORKBENCH_PROVIDER=ai-sdk) requires this key. Development with the mock provider ignores it.
NOVALISTICALLY_AI_API_KEY=
# NOVALISTICALLY_AI_BASE_URL=https://opencode.ai/zen/v1
# NOVALISTICALLY_AI_MODEL=deepseek-v4-flash-free

# ── Workbench launch ──────────────────────────────────────────────────────────
# workbench = composed UI/API (start:workbench/dev); listener = health/status smoke only (start:listener)
WORKBENCH_MODE=workbench
# Absolute project directory containing nova.yaml. Production REQUIRES this; dev falls back to fixtures/zhu-fu when unset.
WORKBENCH_PROJECT_ROOT=
# Absolute SQLite path owned by the Workbench Host. Production REQUIRES this; dev falls back to cwd/.nova/workbench.sqlite.
WORKBENCH_DATABASE_PATH=
# Absolute path to packages/workbench/dist/client. Production REQUIRES this; dev leaves it unset (Vite serves assets).
WORKBENCH_ASSETS_ROOT=
WORKBENCH_PROJECT_ID=
WORKBENCH_DISPLAY_NAME=
WORKBENCH_PORT=8787
WORKBENCH_HOST=loopback
WORKBENCH_LAN=false
WORKBENCH_ALLOWED_HOSTS=127.0.0.1
# Vite dev origin; set an explicit trusted origin when using another browser origin.
WORKBENCH_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional reverse-proxy mode; TLS terminates at the proxy, never in Workbench.
# WORKBENCH_UNIX_SOCKET=/run/fabula/workbench.sock
# WORKBENCH_TRUST_FORWARDED_HEADERS=true

# ── Development-only switches ─────────────────────────────────────────────────
# dev.mjs defaults these to mock/true/true when unset. Production MUST keep the
# ai-sdk/false/false values below; mock rendering and owner bootstrap are never production defaults.
WORKBENCH_PROVIDER=ai-sdk
WORKBENCH_ALLOW_MOCK_PROVIDER=false
WORKBENCH_ALLOW_BOOTSTRAP=false
