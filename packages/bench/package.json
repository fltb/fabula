{
  "name": "@novalistically/bench",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "description": "Benchmark and performance suite for Novalistically — runs the full pipeline on real fixtures and measures throughput at N=10/100/1000.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "bench": "vitest run --root ../.. packages/bench/tests",
    "build": "tsc --emitDeclarationOnly && node build.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@novalistically/core": "*",
    "@novalistically/node-host": "*",
    "apache-arrow": "^21.2.0",
    "tinybench": "^6.1.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
