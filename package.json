{
  "name": "fabula",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:js",
    "build:types": "tsc -b packages/core packages/bench packages/cli",
    "build:js": "node packages/core/build.mjs && node packages/bench/build.mjs && node packages/cli/build.mjs",
    "smoke:stage1:live": "node packages/bench/scripts/generate-reference.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run -w @novalistically/bench bench",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b packages/core packages/bench packages/cli",
    "typecheck:dead-code": "tsc -b packages/core/tsconfig.dead-code.json packages/bench/tsconfig.dead-code.json packages/cli/tsconfig.dead-code.json",
    "bundle-check": "node scripts/bundle-check.mjs",
    "dead-code:knip": "node scripts/check-public-api.mjs && knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.4.2",
    "knip": "^6.0.0",
    "tinybench": "^6.0.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.12",
    "ai": "^7.0.31"
  }
}
